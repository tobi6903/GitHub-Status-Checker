# Generate with: openssl rand -base64 33
AUTH_SECRET=

# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:      http://localhost:3000
#   Callback URL:      http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Public URL of the app. Required outside Vercel (e.g. `next start`, Docker).
# AUTH_URL=http://localhost:3000

# Optional. Default is "read:user repo" (includes private repos).
# Use "read:user" for public data only.
# GITHUB_OAUTH_SCOPE=read:user repo

# --- AI assistant (/ai) ---
# Powered by LangChain, so it works with Anthropic or OpenAI. Set a shared key for one of them
# (optional: users can also bring their own key on the API key tab).
# (A Claude Code / claude.ai login can't be used: those are for the apps, not the API.)
ANTHROPIC_API_KEY=       # https://console.anthropic.com
OPENAI_API_KEY=          # https://platform.openai.com
# Optional. Default: whichever key is set (Anthropic first).
# AI_PROVIDER=anthropic
# Optional model override. Defaults: claude-opus-5-5 (Anthropic), gpt-5 (OpenAI).
# AI_MODEL=claude-sonnet-5-5
# Production only: GitHub usernames allowed to use THIS server's key (it spends your credits).
# Anyone can still use the AI tools with their own key from the API key tab.
# In development any signed-in user may use the server key.
# AI_ALLOWED_LOGINS=your-github-username

# --- Automatic PR reviews via webhook (optional, off unless all three are set) ---
# GITHUB_WEBHOOK_SECRET=a-long-random-string
# GITHUB_BOT_TOKEN=a token that can read the repos and comment on PRs
# WEBHOOK_REPOS=owner/repo,owner/*
